{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentagriculture:ecosystem:crop-input:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "synthetic_only": {
      "const": true
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "enterprise_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "jurisdiction": {
      "enum": [
        "CA-BC",
        "CA-AB",
        "CA-SK",
        "CA-MB",
        "CA-ON",
        "CA-QC",
        "CA-NB",
        "CA-NS",
        "CA-PE",
        "CA-NL",
        "CA-YT",
        "CA-NT",
        "CA-NU"
      ]
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "type": {
            "enum": [
              "field",
              "bed",
              "block",
              "house"
            ]
          },
          "crop_as_reported": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "stage_as_reported": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "type",
          "crop_as_reported",
          "stage_as_reported"
        ]
      },
      "maxItems": 32,
      "minItems": 1,
      "uniqueItems": true
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "entity_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "source_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "event_state": {
            "enum": [
              "observed",
              "planned",
              "uncertain"
            ]
          },
          "observed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "metric": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "value_state": {
            "enum": [
              "measured",
              "estimated",
              "missing",
              "trace",
              "suppressed"
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$",
                "minLength": 1,
                "maxLength": 60
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          },
          "method": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          },
          "basis": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          },
          "sampling_scope": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          },
          "supersedes": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ]
          },
          "correction_reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "id",
          "entity_id",
          "source_ref",
          "event_state",
          "observed_at",
          "recorded_at",
          "metric",
          "value_state",
          "value",
          "unit",
          "method",
          "basis",
          "sampling_scope",
          "supersedes",
          "correction_reason",
          "note"
        ]
      },
      "maxItems": 200,
      "minItems": 1,
      "uniqueItems": true
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "left": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "right": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "id",
          "left",
          "right"
        ]
      },
      "maxItems": 80,
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "synthetic_only",
    "task_id",
    "enterprise_id",
    "jurisdiction",
    "period",
    "as_of",
    "entities",
    "observations",
    "comparisons"
  ]
}
