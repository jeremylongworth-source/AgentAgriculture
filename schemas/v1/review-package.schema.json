{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentagriculture:schema:review-package:1",
  "title": "review-package",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "package_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "language": {
      "enum": [
        "en",
        "fr"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "enterprise_id": {
          "type": "string",
          "minLength": 1
        },
        "reporting_period": {
          "$ref": "urn:agentagriculture:schema:common:1#/$defs/period"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "transaction_basis": {
          "const": "purchase_records"
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        }
      },
      "required": [
        "enterprise_id",
        "reporting_period",
        "currency",
        "transaction_basis",
        "completeness"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "incomplete",
        "ready_for_review"
      ]
    },
    "delivery_state": {
      "enum": [
        "draft_not_saved",
        "saved_locally"
      ]
    },
    "input_manifest_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:agentagriculture:schema:common:1#/$defs/source-ref"
      },
      "minItems": 1
    },
    "checked_calculation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "minItems": 0
    },
    "exception_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "minItems": 0
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "freshness_note": {
      "type": "string",
      "minLength": 1
    },
    "intended_recipient_scope": {
      "type": "string",
      "minLength": 1
    },
    "export_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "enum": [
              "text/csv",
              "application/json",
              "text/markdown",
              "text/html"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "media_type",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "package_id",
    "task_id",
    "version",
    "created_at",
    "language",
    "question",
    "scope",
    "status",
    "delivery_state",
    "input_manifest_id",
    "source_refs",
    "checked_calculation_ids",
    "exception_ids",
    "assumptions",
    "omissions",
    "unresolved_questions",
    "freshness_note",
    "intended_recipient_scope",
    "export_manifest"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "delivery_state": {
            "const": "saved_locally"
          }
        }
      },
      "then": {
        "properties": {
          "export_manifest": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "media_type": {
                  "enum": [
                    "text/csv",
                    "application/json",
                    "text/markdown",
                    "text/html"
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "media_type",
                "sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready_for_review"
          }
        }
      },
      "then": {
        "properties": {
          "scope": {
            "properties": {
              "completeness": {
                "const": "complete"
              }
            }
          },
          "unresolved_questions": {
            "maxItems": 0
          },
          "omissions": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
