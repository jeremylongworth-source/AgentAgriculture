{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentagriculture:schema:correction:1",
  "title": "correction",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "correction_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "base_version": {
      "type": "integer",
      "minimum": 1
    },
    "new_version": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "authorized_by": {
      "type": "string",
      "minLength": 1
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "set_field",
        "confirm_duplicate",
        "exclude",
        "include"
      ]
    },
    "field": {
      "enum": [
        "enterprise",
        "reference",
        "date",
        "quantity",
        "unit",
        "amount",
        "currency",
        "identity",
        "disposition"
      ]
    },
    "previous_value": {
      "type": [
        "string",
        "null"
      ]
    },
    "value": {
      "type": [
        "string",
        "null"
      ]
    },
    "duplicate_of": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "correction_id",
    "task_id",
    "record_id",
    "base_version",
    "new_version",
    "supersedes",
    "authorized_by",
    "confirmed_at",
    "reason",
    "operation",
    "field",
    "previous_value",
    "value",
    "duplicate_of"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "confirm_duplicate"
          }
        }
      },
      "then": {
        "properties": {
          "duplicate_of": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "const": "identity"
          }
        }
      }
    }
  ]
}
